# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=postgresql://budgy:budgy@db:5432/budgy

# Microsoft Entra ID (Azure AD) SSO
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_REDIRECT_URI=http://localhost:5000/auth/callback

# Admin bootstrap - comma-separated emails
ADMIN_EMAILS=admin@example.com

# Storage backend: "local" or "r2"
STORAGE_BACKEND=local

# Local storage path (development only)
LOCAL_UPLOAD_PATH=uploads

# Cloudflare R2 (production)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=budgy-uploads
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Upload limits
MAX_UPLOAD_SIZE_MB=25

# Reverse proxy
PREFERRED_URL_SCHEME=https

# Application URL (used for OAuth redirect in production)
APP_URL=http://localhost:5000
